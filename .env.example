# Oura API の設定。このファイルを .env にコピーして値を入れてください。
#   cp .env.example .env
# アプリの登録: https://cloud.ouraring.com/oauth/applications

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Oura のアプリ設定に登録した Redirect URI と完全に同じ文字列にする
OURA_REDIRECT_URI=http://localhost:8765/callback

# 求める権限 (スペース区切り)。書かなければ、アプリ登録でチェックしたスコープをすべて求める
# OURA_SCOPES=personal daily heartrate workout spo2 heart_health stress

# ポート番号を変えるときは OURA_REDIRECT_URI も合わせて変える
# OURA_PORT=8765
